# Deskflow server config for the Windows PC ({{SERVER_NAME}}) and the Mac ({{CLIENT_NAME}}).
# Generated by windows/install.ps1 from deskflow/deskflow-server.conf.template:
# edit the template or the config (%LOCALAPPDATA%\switch-mac-win\config.json), then
# re-run the installer. Don't edit the generated copy.
#
# Explicit switching only: no screen links, so the cursor never wanders onto a
# machine the monitor isn't showing. To also allow edge switching, add to section: links
#   {{SERVER_NAME}}:
#       right = {{CLIENT_NAME}}
#   {{CLIENT_NAME}}:
#       left = {{SERVER_NAME}}
#
# The screens themselves (and per-screen options such as the Mac's Ctrl/Cmd remapping)
# live in Deskflow's settings (%APPDATA%\Deskflow\Deskflow.conf): Deskflow 1.27
# ignores a "section: screens" here.

section: links
end

section: options
	heartbeat = 1000
	win32KeepForeground = true
	clipboardSharing = true
	clipboardSharingSize = 3072
	# The toggle is for you; the scripts and the watcher use the explicit ones.
	keystroke({{TOGGLE_KEY}}) = switchToNextScreen
	keystroke({{TO_MAC_KEY}}) = switchToScreen({{CLIENT_NAME}})
	keystroke({{TO_WINDOWS_KEY}}) = switchToScreen({{SERVER_NAME}})
end
