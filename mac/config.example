# switch-mac-win config for the Mac, written by mac/install.sh to
# ~/Library/Application Support/switch-mac-win/config. Shell syntax (it's sourced).
SERVER_NAME='my-pc'         # Deskflow screen name of the Windows PC
SERVER_HOST='my-pc.local'   # host or IP address of the Windows PC
CLIENT_NAME='my-mac'        # Deskflow screen name of this Mac
CLIENT_HOST='my-mac.local'  # host or IP address of this Mac
WAKE_PORT='47999'
WAKE_TOKEN='generated-by-the-installer'
