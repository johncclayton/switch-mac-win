<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wake listener: lets the Windows PC wake this Mac without SSH (docs/adr/0001).
  launchd listens on the port and advertises it over Bonjour, so a connection wakes
  a sleeping Mac (a "dark wake": screen off, Deskflow disconnected). For each
  connection it runs wake.sh, which checks the wake token and runs caffeinate -u to
  turn that into a full wake. Generated by mac/install.sh; don't edit the installed copy.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.switch-mac-win.wake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{WAKE_SCRIPT}}</string>
    </array>
    <key>inetdCompatibility</key>
    <dict>
        <key>Wait</key>
        <false/>
    </dict>
    <key>Sockets</key>
    <dict>
        <key>Listener</key>
        <dict>
            <key>SockServiceName</key>
            <string>{{WAKE_PORT}}</string>
            <key>SockType</key>
            <string>stream</string>
            <key>Bonjour</key>
            <string>switch-mac-win-wake</string>
        </dict>
    </dict>
</dict>
</plist>
