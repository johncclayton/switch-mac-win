<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wakes the Mac when Windows connects to TCP port 47999, without SSH.
  launchd listens on the port and advertises it over Bonjour, so a connection
  wakes a sleeping Mac (a "dark wake": screen off, Deskflow disconnected). It then
  runs caffeinate -u for each connection, which declares user activity and turns
  that into a full wake.
  Experimental: no authentication or rate limiting yet. mac/install.sh installs it as
  ~/Library/LaunchAgents/com.switch-mac-win.wake.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.switch-mac-win.wake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-u</string>
        <string>-t</string>
        <string>2</string>
    </array>
    <key>inetdCompatibility</key>
    <dict>
        <key>Wait</key>
        <false/>
    </dict>
    <key>Sockets</key>
    <dict>
        <key>Listener</key>
        <dict>
            <key>SockServiceName</key>
            <string>47999</string>
            <key>SockType</key>
            <string>stream</string>
            <key>Bonjour</key>
            <string>switch-mac-win-wake</string>
        </dict>
    </dict>
</dict>
</plist>
