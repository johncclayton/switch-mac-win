<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeper: runs keep-deskflow.sh every 15 s to keep Deskflow running on this Mac
  (docs/adr/0003). Generated by mac/install.sh; don't edit the installed copy.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.switch-mac-win.deskflow</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{KEEP_SCRIPT}}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>15</integer>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/switch-mac-win-keeper.log</string>
</dict>
</plist>
